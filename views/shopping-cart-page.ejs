<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Cart | SWORV Studios</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://res.cloudinary.com/dirijnb2k/image/upload/sworv-logo.png"
      type="image/png"
      rel="icon"
    />
    <link rel="stylesheet" href="app.css" />
  </head>

  <body class="sc-page" id="shoppingCartPage">
    <%- include("partials/navbar") %>

    <div class="sc-heading container">
      <a href="/shopPage">
        <img
          src="https://res.cloudinary.com/dirijnb2k/image/upload/sworv-logo.png"
          alt="logo"
          class="sc-page-logo-img"
        />
      </a>
      <h5 id="cartPageheader" class="text-uppercase">Your Shopping Bag</h5>
    </div>

    <main class="main-page container" id="scMainPage"></main>

    <div
      class="total-container container d-flex justify-content-between align-items-center"
      id="totalContainer"
    >
      <div class="keep-shopping-container">
        <a
          href="/shopPage"
          class="text-secondary text-decoration-none fw-bold small uppercase"
        >
          ← Keep Shopping
        </a>
      </div>

      <p class="fw-bold subtotal-texts mb-0 text-light">
        SUBTOTAL:
        <span class="actual-subtotal text-silver" id="subTotal"></span>
      </p>
    </div>

    <div class="checkout-container" id="checkoutContainer">
      <a href="#" class="checkout-btn fw-bold text-uppercase" id="checkoutBtn"
        >Proceed to Checkout</a
      >
    </div>

    <%- include("partials/footer") %>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
    <script src="include.js" defer></script>
    <script src="app.js" defer></script>
  </body>
</html>
