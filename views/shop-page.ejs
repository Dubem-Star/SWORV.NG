<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shop | SWORV Studios</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      href="https://res.cloudinary.com/dirijnb2k/image/upload/sworv-logo.png"
      type="image/png"
      rel="icon"
    />
    <link rel="stylesheet" href="app.css" />
  </head>
  <body id="shopPage">
    <%- include("partials/navbar") %>

    <div class="container py-5">
      <div class="text-center mb-5">
        <h2 class="fw-bold text-uppercase tracking-wider">Catalog</h2>
        <p class="text-secondary">Available Stock & Custom Pieces</p>
      </div>

      <div class="container products-container">
        <div class="row g-4" id="productGrid">
          <% products.forEach(product => { %>
          <div class="col-6 col-md-4 col-lg-3">
            <a
              href="/details?id=<%= product._id %>"
              class="text-decoration-none"
            >
              <div class="product-card">
                <!-- Image & Swap Wrap -->
                <div class="product-img-wrap">
                  <% if (product.isSoldOut) { %>
                  <div class="sold-out-badge">Sold Out</div>
                  <% } %>

                  <!-- Front Image -->
                  <img
                    src="<%= product.image[0] %>"
                    alt="<%= product.title %>"
                    class="card-imgs img-front"
                  />

                  <!-- Back Image (Checks if index 1 is available, otherwise reuses front) -->
                  <% if (product.image && product.image[1]) { %>
                  <img
                    src="<%= product.image[1] %>"
                    alt="<%= product.title %> - Back View"
                    class="card-imgs img-back"
                  />
                  <% } %>

                  <!-- Quick Add Overlay -->
                  <div class="quick-add">
                    <i class="bi bi-plus me-1"></i>Quick Add
                  </div>
                </div>

                <!-- Title & Price on Top / Bottom -->
                <div class="product-header-top">
                  <div class="product-name-top"><%= product.title %></div>
                  <div class="product-price-top">
                    ₦<%= product.price.toLocaleString() %>
                  </div>
                </div>
              </div>
            </a>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <%- include("partials/footer") %>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
    <script src="include.js" defer></script>
    <script src="app.js" defer></script>
  </body>
</html>
