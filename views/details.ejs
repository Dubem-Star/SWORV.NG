<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.title %> | SWORV Studios</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
      rel="stylesheet"
    />

    <link
      href="https://res.cloudinary.com/dirijnb2k/image/upload/sworv-logo.png"
      type="image/png"
      rel="icon"
    />
    <link rel="stylesheet" href="app.css" />
  </head>
  <body id="detailsPage">
    <%- include("partials/navbar") %>

    <!-- PREVIEW & MAIN PRODUCT IMAGES SECTION -->
    <main class="d-container">
      <div class="detail-row">
        <!-- Thumbnail column -->
        <div class="mini-imgs">
          <% for(let img of product.image) {%>
          <div class="prev-cont">
            <img src="<%= img %>" alt="preview-image" class="swap" />
          </div>
          <% } %>
        </div>

        <!-- Main Product Image with Zoom Support -->
        <div class="img-col">
          <div class="zoom-col" id="zoomCont">
            <img
              src="<%= product.image[0] %>"
              class="product-img img-fluid"
              id="productImg"
              alt="<%= product.title %>"
            />
          </div>
        </div>

        <!-- Description & Purchase Column -->
        <div class="card description-col">
          <h4 class="detail-card-title" id="productName">
            <%= product.title %>
          </h4>
          <p class="card-text lead info" id="productDescription">
            <%= product.description %>
          </p>

          <div class="product-size-container" id="productSizeBox">
            <div class="size-input-wrapper">
              <label for="productSize" class="label-text">
                <strong>Size:</strong></label
              >
              <select
                name="size"
                class="form-control size-selection"
                id="productSize"
                required
              >
                <option value="" disabled selected hidden>
                  --select size--
                </option>
                <option value="Small">Small</option>
                <option value="Medium">Medium</option>
                <option value="Large">Large</option>
                <option value="XtraLarge">Xtra Large</option>
                <option value="XxtraLarge">XX Large</option>
              </select>
            </div>
          </div>

          <span id="cautionMsg" class="caution-message">
            <i class="bi bi-exclamation-triangle"></i> Kindly select a size
          </span>

          <span class="card-text price-text" id="productPrice">
            ₦<%= product.price.toLocaleString() %>
          </span>

          <button class="btn btn-primary atc-btn mt-2 text-dark" id="atcBtn">
            Add to Bag
          </button>
        </div>
      </div>
    </main>

    <!-- Keep Shopping Carousel Section -->
    <section class="carousel">
      <section class="carousel-header">
        <h5>Keep Shopping</h5>
      </section>
      <div class="mini-container">
        <div class="scroll">
          <i class="bi bi-chevron-left arrow"></i>
        </div>
        <div class="related-products-carousel">
          <% for(let item of products){ %>
          <a href="/details?id=<%= item._id %>">
            <div class="carousel-product-card">
              <img
                src="<%= item.image[0] %>"
                alt="carousel-img"
                class="carousel-img"
              />
            </div>
          </a>
          <% } %>
        </div>
        <div class="scroll">
          <i class="bi bi-chevron-right arrow"></i>
        </div>
      </div>
    </section>

    <%- include("partials/footer") %>

    <script src="include.js" defer></script>
    <script src="app.js" defer></script>
  </body>
</html>
